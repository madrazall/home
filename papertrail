  <script>
    async function handleSubmit() {
      const name     = document.getElementById('full-name').value.trim();
      const email    = document.getElementById('buyer-email').value.trim();
      const addr1    = document.getElementById('addr1').value.trim();
      const addr2    = document.getElementById('addr2').value.trim();
      const city     = document.getElementById('city').value.trim();
      const state    = document.getElementById('state').value.trim().toUpperCase();
      const zip      = document.getElementById('zip').value.trim();
      const qty      = document.getElementById('qty').value;

      if (!name || !email || !addr1 || !city || !state || !zip) {
        alert('Please fill in all required fields.');
        return;
      }
      if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
        alert('Please enter a valid email address.');
        return;
      }

      document.getElementById('step-form').style.display = 'none';
      document.getElementById('step-sending').style.display = 'block';

      const address = [addr1, addr2, city, state, zip].filter(Boolean).join(', ');
      const subject = encodeURIComponent('Paper Trail Order — ' + name);
      const body    = encodeURIComponent(
        'NEW PAPER TRAIL ORDER\n\n' +
        'Name: ' + name + '\n' +
        'Email: ' + email + '\n' +
        'Shipping Address: ' + address + '\n' +
        'Quantity: ' + qty + ' cop' + (qty === '1' ? 'y' : 'ies') + '\n' +
        'Amount: $19.99/copy + shipping\n\n' +
        '--- MATCH THIS ORDER ---\n' +
        'Find payment in Stripe dashboard by searching: ' + email + '\n' +
        '------------------------'
      );

      // Open mailto in background then redirect to Stripe
      window.location.href = 'mailto:madrazall@proton.me?subject=' + subject + '&body=' + body;

      setTimeout(() => {
        document.getElementById('step-sending').style.display = 'none';
        document.getElementById('step-redirect').style.display = 'block';
        setTimeout(() => {
          window.location.href = 'https://buy.stripe.com/5kQ5kC67PfJFfaq72d4ko01';
        }, 1500);
      }, 800);
    }
  </script>

