:root {
  --bg: #060810;
  --surface: #0d1117;
  --surface2: #111827;
  --cyan: #00c8e0;
  --cyan-dim: rgba(0,200,224,0.12);
  --cyan-glow: rgba(0,200,224,0.25);
  --white: #f0f4f8;
  --muted: #6b7a8d;
  --paper: #e8e4dc;
  --paper-dark: #c9c3b8;
}

html { scroll-behavior: smooth; }

body {
  background: var(--bg);
  color: var(--white);
  font-family: 'DM Sans', sans-serif;
  font-weight: 300;
  line-height: 1.7;
  overflow-x: hidden;
}

/* ── NAV ── */
nav {
  position: fixed;
  top: 0; left: 0; right: 0;
  z-index: 100;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 1.2rem 2.5rem;
  background: rgba(6,8,16,0.85);
  backdrop-filter: blur(12px);
  border-bottom: 1px solid rgba(0,200,224,0.1);
}
.nav-logo {
  font-family: 'Bebas Neue', sans-serif;
  font-size: 1.3rem;
  letter-spacing: 0.15em;
  color: var(--cyan);
  text-decoration: none;
}
.nav-back {
  font-family: 'DM Mono', monospace;
  font-size: 0.72rem;
  color: var(--muted);
  text-decoration: none;
  letter-spacing: 0.1em;
  transition: color 0.2s;
}
.nav-back:hover { color: var(--cyan); }

/* ── HERO ── */
.hero {
  min-height: 100vh;
  display: grid;
  grid-template-columns: 1fr 1fr;
  align-items: center;
  gap: 4rem;
  padding: 8rem 5rem 5rem;
  position: relative;
  overflow: hidden;
}

.hero::before {
  content: '';
  position: absolute;
  inset: 0;
  background:
    radial-gradient(ellipse 60% 50% at 80% 50%, rgba(0,200,224,0.07) 0%, transparent 70%),
    radial-gradient(ellipse 40% 60% at 10% 80%, rgba(0,200,224,0.04) 0%, transparent 60%);
  pointer-events: none;
}

/* grid lines */
.hero::after {
  content: '';
  position: absolute;
  inset: 0;
  background-image:
    linear-gradient(rgba(0,200,224,0.03) 1px, transparent 1px),
    linear-gradient(90deg, rgba(0,200,224,0.03) 1px, transparent 1px);
  background-size: 60px 60px;
  pointer-events: none;
}

.hero-text { position: relative; z-index: 2; }

.hero-label {
  font-family: 'DM Mono', monospace;
  font-size: 0.7rem;
  letter-spacing: 0.25em;
  color: var(--cyan);
  text-transform: uppercase;
  margin-bottom: 1.5rem;
  display: flex;
  align-items: center;
  gap: 0.75rem;
}
.hero-label::before {
  content: '';
  display: inline-block;
  width: 2rem;
  height: 1px;
  background: var(--cyan);
}

.hero-title {
  font-family: 'Playfair Display', serif;
  font-size: clamp(3.5rem, 7vw, 5.5rem);
  font-weight: 700;
  line-height: 1;
  letter-spacing: -0.01em;
  color: var(--white);
  margin-bottom: 1rem;
}

.hero-subtitle {
  font-family: 'Playfair Display', serif;
  font-style: italic;
  font-size: clamp(1rem, 2vw, 1.25rem);
  color: var(--cyan);
  font-weight: 500;
  margin-bottom: 2rem;
  letter-spacing: 0.02em;
}

.hero-desc {
  font-size: 1rem;
  color: rgba(240,244,248,0.75);
  max-width: 480px;
  margin-bottom: 2.5rem;
  line-height: 1.8;
}

.hero-author {
  font-family: 'DM Mono', monospace;
  font-size: 0.75rem;
  letter-spacing: 0.15em;
  color: var(--muted);
  text-transform: uppercase;
}

.cta-group {
  display: flex;
  gap: 1rem;
  align-items: center;
  flex-wrap: wrap;
  margin-bottom: 2rem;
}

.btn-primary {
  background: var(--cyan);
  color: var(--bg);
  font-family: 'Bebas Neue', sans-serif;
  font-size: 1rem;
  letter-spacing: 0.15em;
  padding: 0.9rem 2.2rem;
  border: none;
  cursor: pointer;
  text-decoration: none;
  display: inline-block;
  transition: all 0.2s;
  clip-path: polygon(0 0, calc(100% - 10px) 0, 100% 10px, 100% 100%, 10px 100%, 0 calc(100% - 10px));
}
.btn-primary:hover {
  background: #00e5ff;
  transform: translateY(-2px);
  box-shadow: 0 8px 30px rgba(0,200,224,0.35);
}

.btn-secondary {
  color: var(--cyan);
  font-family: 'DM Mono', monospace;
  font-size: 0.75rem;
  letter-spacing: 0.12em;
  text-decoration: none;
  border-bottom: 1px solid rgba(0,200,224,0.3);
  padding-bottom: 2px;
  transition: border-color 0.2s;
}
.btn-secondary:hover { border-color: var(--cyan); }

/* ── BOOK COVER SIDE ── */
.hero-visual {
  position: relative;
  z-index: 2;
  display: flex;
  justify-content: center;
  align-items: center;
}

.book-wrap {
  position: relative;
  width: 280px;
  animation: float 4s ease-in-out infinite;
}

@keyframes float {
  0%, 100% { transform: translateY(0px); }
  50% { transform: translateY(-12px); }
}

.book-glow {
  position: absolute;
  inset: -30px;
  background: radial-gradient(ellipse at center, rgba(0,200,224,0.2) 0%, transparent 70%);
  pointer-events: none;
}

.book-cover {
  width: 100%;
  border: 1px solid rgba(0,200,224,0.15);
  box-shadow:
    0 30px 80px rgba(0,0,0,0.8),
    0 0 0 1px rgba(0,200,224,0.1),
    inset 0 1px 0 rgba(255,255,255,0.05);
  display: block;
}

/* Simulated cover if no image */
.book-cover-fallback {
  width: 280px;
  height: 380px;
  background: linear-gradient(160deg, #1a1a1a 0%, #0d0d0d 100%);
  border: 1px solid rgba(0,200,224,0.2);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 2.5rem;
  text-align: center;
  box-shadow: 0 30px 80px rgba(0,0,0,0.8);
}

.cover-title-fake {
  font-family: 'Playfair Display', serif;
  font-size: 2rem;
  font-weight: 700;
  color: var(--white);
  margin-bottom: 1.5rem;
}
.cover-tagline-fake {
  font-family: 'DM Sans', sans-serif;
  font-size: 0.85rem;
  color: var(--muted);
  font-style: italic;
  line-height: 1.6;
  margin-bottom: 2rem;
}
.cover-author-fake {
  font-family: 'Playfair Display', serif;
  font-size: 0.9rem;
  color: rgba(240,244,248,0.6);
}

/* ── WHAT'S INSIDE ── */
.features {
  padding: 6rem 5rem;
  background: var(--surface);
  position: relative;
}

.features::before {
  content: '';
  position: absolute;
  top: 0; left: 0; right: 0;
  height: 1px;
  background: linear-gradient(90deg, transparent, var(--cyan), transparent);
}

.section-label {
  font-family: 'DM Mono', monospace;
  font-size: 0.68rem;
  letter-spacing: 0.3em;
  color: var(--cyan);
  text-transform: uppercase;
  margin-bottom: 1rem;
}

.section-title {
  font-family: 'Playfair Display', serif;
  font-size: clamp(2rem, 4vw, 3rem);
  font-weight: 700;
  margin-bottom: 3.5rem;
  color: var(--white);
}

.features-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
  gap: 1.5rem;
}

.feature-card {
  background: var(--bg);
  border: 1px solid rgba(0,200,224,0.1);
  padding: 2rem;
  position: relative;
  transition: border-color 0.3s, transform 0.3s;
}
.feature-card::before {
  content: '';
  position: absolute;
  top: 0; left: 0;
  width: 3px;
  height: 0;
  background: var(--cyan);
  transition: height 0.3s;
}
.feature-card:hover {
  border-color: rgba(0,200,224,0.3);
  transform: translateY(-3px);
}
.feature-card:hover::before { height: 100%; }

.feature-icon {
  font-size: 1.5rem;
  margin-bottom: 1rem;
}
.feature-title {
  font-family: 'DM Sans', sans-serif;
  font-weight: 500;
  font-size: 0.95rem;
  color: var(--white);
  margin-bottom: 0.5rem;
}
.feature-desc {
  font-size: 0.85rem;
  color: var(--muted);
  line-height: 1.7;
}

/* ── PURCHASE ── */
.purchase {
  padding: 6rem 5rem;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 5rem;
  align-items: start;
  max-width: 1100px;
  margin: 0 auto;
}

.purchase-info h2 {
  font-family: 'Playfair Display', serif;
  font-size: clamp(2rem, 3.5vw, 2.8rem);
  font-weight: 700;
  margin-bottom: 1rem;
  color: var(--white);
}

.purchase-info p {
  color: rgba(240,244,248,0.7);
  font-size: 0.95rem;
  margin-bottom: 1.5rem;
  line-height: 1.8;
}

.price-display {
  display: inline-flex;
  align-items: baseline;
  gap: 0.25rem;
  margin-bottom: 2rem;
}
.price-dollar {
  font-family: 'DM Mono', monospace;
  font-size: 1rem;
  color: var(--cyan);
}
.price-amount {
  font-family: 'Bebas Neue', sans-serif;
  font-size: 3.5rem;
  color: var(--cyan);
  line-height: 1;
}
.price-note {
  font-family: 'DM Mono', monospace;
  font-size: 0.65rem;
  color: var(--muted);
  letter-spacing: 0.1em;
  align-self: flex-end;
  padding-bottom: 0.5rem;
}

.disclaimer {
  font-family: 'DM Mono', monospace;
  font-size: 0.65rem;
  color: var(--muted);
  letter-spacing: 0.08em;
  border-top: 1px solid rgba(0,200,224,0.1);
  padding-top: 1.5rem;
  margin-top: 1rem;
  line-height: 1.7;
}

/* ── FORM ── */
.purchase-form-wrap {
  background: var(--surface);
  border: 1px solid rgba(0,200,224,0.15);
  padding: 2.5rem;
  position: relative;
}
.purchase-form-wrap::before {
  content: '';
  position: absolute;
  top: 0; left: 0; right: 0;
  height: 2px;
  background: linear-gradient(90deg, var(--cyan), transparent);
}

.form-title {
  font-family: 'Bebas Neue', sans-serif;
  font-size: 1.4rem;
  letter-spacing: 0.1em;
  color: var(--white);
  margin-bottom: 0.25rem;
}
.form-sub {
  font-size: 0.8rem;
  color: var(--muted);
  margin-bottom: 2rem;
}

.form-group {
  margin-bottom: 1.25rem;
}
.form-label {
  display: block;
  font-family: 'DM Mono', monospace;
  font-size: 0.65rem;
  letter-spacing: 0.15em;
  color: var(--cyan);
  text-transform: uppercase;
  margin-bottom: 0.5rem;
}
.form-input, .form-select {
  width: 100%;
  background: var(--bg);
  border: 1px solid rgba(0,200,224,0.15);
  color: var(--white);
  font-family: 'DM Sans', sans-serif;
  font-size: 0.9rem;
  padding: 0.75rem 1rem;
  outline: none;
  transition: border-color 0.2s;
  -webkit-appearance: none;
  border-radius: 0;
}
.form-input:focus, .form-select:focus {
  border-color: var(--cyan);
  box-shadow: 0 0 0 3px var(--cyan-dim);
}
.form-input::placeholder { color: var(--muted); }
.form-select option { background: var(--surface2); }

.form-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 1rem;
}

.submit-btn {
  width: 100%;
  background: var(--cyan);
  color: var(--bg);
  font-family: 'Bebas Neue', sans-serif;
  font-size: 1.1rem;
  letter-spacing: 0.15em;
  padding: 1rem;
  border: none;
  cursor: pointer;
  margin-top: 0.5rem;
  transition: all 0.2s;
  clip-path: polygon(0 0, calc(100% - 8px) 0, 100% 8px, 100% 100%, 8px 100%, 0 calc(100% - 8px));
}
.submit-btn:hover {
  background: #00e5ff;
  transform: translateY(-1px);
  box-shadow: 0 8px 25px rgba(0,200,224,0.4);
}

.secure-note {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  margin-top: 1rem;
  font-family: 'DM Mono', monospace;
  font-size: 0.63rem;
  color: var(--muted);
  letter-spacing: 0.08em;
}
.secure-dot {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: var(--cyan);
  flex-shrink: 0;
}

/* ── SUCCESS STATE ── */
.success-state {
  display: none;
  text-align: center;
  padding: 2rem 0;
}
.success-icon {
  font-size: 3rem;
  margin-bottom: 1rem;
}
.success-title {
  font-family: 'Playfair Display', serif;
  font-size: 1.5rem;
  font-weight: 700;
  color: var(--white);
  margin-bottom: 0.5rem;
}
.success-desc {
  font-size: 0.85rem;
  color: var(--muted);
  line-height: 1.7;
}

/* ── FOOTER ── */
footer {
  border-top: 1px solid rgba(0,200,224,0.08);
  padding: 2rem 5rem;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 1rem;
  flex-wrap: wrap;
}
.footer-brand {
  font-family: 'Bebas Neue', sans-serif;
  font-size: 1rem;
  letter-spacing: 0.15em;
  color: var(--cyan);
}
.footer-copy {
  font-family: 'DM Mono', monospace;
  font-size: 0.65rem;
  color: var(--muted);
  letter-spacing: 0.08em;
}

/* ── RESPONSIVE ── */
@media (max-width: 900px) {
  .hero {
    grid-template-columns: 1fr;
    padding: 7rem 2rem 4rem;
    text-align: center;
    gap: 3rem;
  }
  .hero-desc { max-width: 100%; }
  .hero-label { justify-content: center; }
  .cta-group { justify-content: center; }
  .hero-visual { order: -1; }
  .book-wrap { width: 220px; }
  .features { padding: 4rem 2rem; }
  .purchase {
    grid-template-columns: 1fr;
    padding: 4rem 2rem;
    gap: 3rem;
  }
  footer { padding: 2rem; flex-direction: column; text-align: center; }
  nav { padding: 1rem 1.5rem; }
}
